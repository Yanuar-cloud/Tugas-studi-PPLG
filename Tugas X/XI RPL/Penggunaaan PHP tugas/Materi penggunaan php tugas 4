<?php
// 1. Inisialisasi variabel untuk menampung pesan error
$errNama = $errEmail = $errTelepon = "";
$nama = $email = $telepon = $alamat = "";
$sukses = false;

// 2. Mengecek apakah form sudah di-submit (Form Handling & Validation)
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    
    // --- Validasi Nama ---
    if (empty($_POST["nama"])) {
        $errNama = "Tidak boleh kosong";
    } else {
        $nama = htmlspecialchars($_POST["nama"]);
    }
    
    // --- Validasi Email ---
    if (empty($_POST["email"])) {
        $errEmail = "Tidak boleh kosong";
    } else {
        $email = htmlspecialchars($_POST["email"]);
        // Cek format email menggunakan filter_var bawaan PHP
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $errEmail = "Format email salah";
        }
    }
    
    // --- Validasi Telepon ---
    if (empty($_POST["telepon"])) {
        $errTelepon = "Tidak boleh kosong";
    } else {
        $telepon = htmlspecialchars($_POST["telepon"]);
        // Cek apakah inputan hanya angka menggunakan ctype_digit
        if (!ctype_digit($telepon)) {
            $errTelepon = "Nomor HP hanya boleh angka";
        }
    }
    
    // Alamat (Opsional, tidak masuk kriteria required)
    $alamat = htmlspecialchars($_POST["alamat"]);

    // Jika semua pesan error kosong, berarti validasi sukses
    if ($errNama == "" && $errEmail == "" && $errTelepon == "") {
        $sukses = true;
    }
}
?>

