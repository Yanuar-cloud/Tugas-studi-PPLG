    <?php
    // Jika sukses lolos validasi, tampilkan hasilnya di sini
    if ($sukses) {
        echo "<div class='sukses-box'>";
        echo "<h4>Data Berhasil Diproses!</h4>";
        echo "<b>Nama:</b> $nama <br>";
        echo "<b>Email:</b> $email <br>";
        echo "<b>Telepon:</b> $telepon <br>";
        echo "<b>Alamat:</b> " . (!empty($alamat) ? $alamat : "-") . "<br>";
        echo "</div>";
    }
    ?>

    <form method="post" action="<?php echo htmlspecialchars($_SERVER["PHP_SELF"]);?>">
        
        <div class="form-group">
            <label>Nama:</label>
            <input type="text" name="nama" value="<?php echo $nama; ?>">
            <span class="error">* <?php echo $errNama; ?></span>
        </div>

        <div class="form-group">
            <label>Email:</label>
            <input type="text" name="email" value="<?php echo $email; ?>">
            <span class="error">* <?php echo $errEmail; ?></span>
        </div>

        <div class="form-group">
            <label>Telepon / No HP:</label>
            <input type="text" name="telepon" value="<?php echo $telepon; ?>">
            <span class="error">* <?php echo $errTelepon; ?></span>
        </div>

        <div class="form-group">
            <label>Alamat:</label>
            <textarea name="alamat" rows="3"><?php echo $alamat; ?></textarea>
        </div>

        <input type="submit" name="submit" value="Kirim Data">
    </form>

