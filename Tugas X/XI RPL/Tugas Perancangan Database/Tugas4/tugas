-- Membuat VIEW peminjaman aktif
--bisa dijalanin di phpMyAdmin atau MySQL
CREATE VIEW view_peminjaman_aktif AS
SELECT
    p.id_peminjaman,
    p.id_siswa,
    s.nama_siswa,
    p.tgl_pinjam,
    p.tgl_kembali,
    p.status
FROM peminjaman AS p
JOIN siswa AS s
    ON p.id_siswa = s.id_siswa
WHERE p.status = 'Belum Dikembalikan';


-- Menampilkan data dari VIEW
SELECT * FROM view_peminjaman_aktif;

