-- 1. Membuat Database dataobat
CREATE DATABASE IF NOT EXISTS dataobat;
USE dataobat;

-- 2. Membuat Tabel obat sesuai ketentuan gambar
CREATE TABLE IF NOT EXISTS obat (
    kode_obat INT(225) NOT NULL AUTO_INCREMENT,
    nama_obat VARCHAR(225) NOT NULL,
    stok INT(225) NOT NULL,
    harga INT(225) NOT NULL,
    PRIMARY KEY (kode_obat)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

