if (isset($_GET['id'])) {
    $id = $_GET['id'];

    // Perintah SQL menghapus data berdasarkan kode_obat
    $delete = mysqli_query($koneksi, "DELETE FROM obat WHERE kode_obat = '$id'");

    if ($delete) {
        echo "<script>alert('Obat berhasil dihapus dari sistem!'); window.location='index.php';</script>";
    } else {
        echo "<script>alert('Gagal menghapus data obat.'); window.location='index.php';</script>";
    }
} else {
    header("Location: index.php");
}
